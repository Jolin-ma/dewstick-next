# Copy to .env.local (git-ignored) and fill in.
SHOPIFY_STORE_DOMAIN=dewstick.myshopify.com
# Shopify admin → Sales channels → Headless → dewstick-next → Storefront API → Public access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
# Shopify admin → Settings → Notifications → Webhooks: the key under "Your webhooks will be signed with"
SHOPIFY_WEBHOOK_SECRET=
